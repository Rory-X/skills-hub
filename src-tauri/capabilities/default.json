{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/login/device*" },
        { "url": "https://gitlab.com/oauth/*" },
        { "url": "https://gitee.com/oauth/*" }
      ]
    }
  ]
}
